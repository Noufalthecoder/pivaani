# Copy to backend/.env and fill in. Never commit the real .env.

# Sarvam AI key for neural TTS (Bulbul) and STT (Saarika).
# Leave empty to run fully offline: the browser's speech engine is used instead.
SARVAM_API_KEY=

# 1 = skip Sarvam calls even when a key is set (scripted/offline demos)
DEMO_SCRIPTED=0

# Every soundbox line is spoken in each of these languages, in order (English first, then Hindi)
VOICE_LANGS=en-IN,hi-IN

# Bharosa receipt languages
CUSTOMER_VOICE_LANG=hi-IN
MERCHANT_VOICE_LANG=en-IN

# Seconds a payment may stay PENDING before a case opens
DETECT_AFTER_SECONDS=2

# HMAC key that signs the audit chain head (a random local key is generated if empty)
AUDIT_SIGNING_KEY=

# Optional overrides
# DATABASE_URL=sqlite:///./backend/pivaani.db
# SARVAM_STT_MODEL=saarika:v2.5
